<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <meta charset="utf-8">
  <title>Book Notes</title>
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.3/css/all.css"
    integrity="sha384-UHRtZLI+pbxtHCWp1t77Bi1L4ZtiqrqD80Kn4Z8NTSRyMA2Fd33n5dQ8lWUE00s/" crossorigin="anonymous">
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css"
    integrity="sha384-GJzZqFGwb1QTTN6wy59ffF1BuGJpLSa9DkKMp0DgiMDm4iYMj70gZWKYbI706tWS" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/myBooks.css">
  <link rel="stylesheet" href="popupS.css">
</head>
<style>

</style>

<body>

  <%- include("partials/header.ejs") %>

    <section>
      <div class="container">
        <div class="text-center mb-5 mt-5">
          <h2>Ready To Read:</h2>
        </div>
        <table class="table">
          <thead>
            <tr>
              <th scope="col">ID.</th>
              <th scope="col">Title</th>
              <th scope="col">Author</th>
              <th scope="col">Year</th>
              <th scope="col"></th>
              <th scope="col"></th>
            </tr>
          </thead>
          <tbody class="table-group-divider">
            <% books.forEach(book=> { %>
              <tr data-id="<%= book.id %>">
                <th scope="row">
                  <%= book.id %>
                </th>
                <td>
                  <%= book.title %>
                </td>
                <td>
                  <%= book.author %>
                </td>
                <td>
                  <%= book.year %>
                </td>

                <% if(book.read) {%>
                  <td><svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" fill="green" class="bi bi-check2"
                      viewBox="0 0 16 16">
                      <path
                        d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0" />
                    </svg></td>
                  <% } else {%>
                    <td><button type="button" class="btn btn-primary set-read-button" onclick="markAsRead()" data-id="<%= book.id %>">Mark as
                        Read</button></td>
                    <%} %>
                      <td>
                        <form action="/delete" method="POST" onsubmit="return confirmDelete()">
                          <input type="hidden" name="deleteBookById" value="<%= book.id %>">
                          <button type="submit" class="btn btn-danger">Delete Book</button>
                        </form>
                      </td>
              </tr>
              <% }) %>
          </tbody>
        </table>
      </div>
    </section>




    <%- include("partials/footer.ejs") %>


</body>

<script>
  document.addEventListener("click", async (e) => {
    if (e.target.matches(".set-read-button")) {
      const bookId = e.target.dataset.id;

      const res = await fetch(`/books/${bookId}/set-read`, {
        method: "POST",
        headers: { "Content-Type": "application/json" }
      });
      const data = await res.json();
      if (data.success) {
        window.location.reload();
      }
    }
  });

  function markAsRead() {
    confirm("Are you sure you read this book?");
  };

  function confirmDelete() {
    return confirm("Are you sure you want to delete this book?")
};

</script>

</html>