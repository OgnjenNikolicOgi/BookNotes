<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <meta charset="utf-8">
  <title>Book Notes</title>
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.3/css/all.css"
    integrity="sha384-UHRtZLI+pbxtHCWp1t77Bi1L4ZtiqrqD80Kn4Z8NTSRyMA2Fd33n5dQ8lWUE00s/" crossorigin="anonymous">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/myBooks.css">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<style>

</style>

<body>

  <%- include("partials/header.ejs") %>

    <section>
      <div class="container">
        <div class="text-center mb-5 mt-5">
          <h2>Ready To Read:</h2>
        </div>
        <div class="container mt-5 mb-5">
          <div class="row">
            <div class=" col-12 d-flex justify-content-end">
              <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#addBookModal">
                Add book
              </button>
            </div>
          </div>
        </div>
        <table class="table">
          <thead>
            <tr>
              <th scope="col">ID.</th>
              <th scope="col">Title</th>
              <th scope="col">Author</th>
              <th scope="col">Year</th>
              <th scope="col"></th>
              <th scope="col"></th>
            </tr>
          </thead>
          <tbody class="table-group-divider">
            <% books.forEach(book=> { %>
              <tr data-id="<%= book.id %>">
                <th scope="row">
                  <%= book.id %>
                </th>
                <td>
                  <%= book.title %>
                </td>
                <td>
                  <%= book.author %>
                </td>
                <td>
                  <%= book.year %>
                </td>

                <% if(book.read) {%>
                  <td><svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" fill="green" class="bi bi-check2"
                      viewBox="0 0 16 16">
                      <path
                        d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0" />
                    </svg></td>
                  <% } else {%>
                    <td>
                      <button type="button" class="btn btn-primary set-read-button" data-bs-toggle="modal" data-bs-target="#markAsReadModal" data-id="<%= book.id %>">
                        Mark as Read
                      </button>
                    </td>
                    <%} %>
                      <td>
                        <button type="button" class="btn btn-danger set-delete-button" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="<%= book.id %>">
                          Delete Book
                        </button>
                      </td>
              </tr>
              <% }) %>
          </tbody>
        </table>
      </div>
    </section>

  <!-- The ADD BOOK Modal -->
<div class="modal" id="addBookModal">
  <div class="modal-dialog">
    <div class="modal-content">

      <!-- Modal Header -->
      <div class="modal-header">
        <h4 class="modal-title">Add Book</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        <label for="title" class="form-label">Title:</label>
        <input type="title" class="form-control" id="modalTitle" placeholder="Title" name="title" required >
        <label for="author" class="form-label">Author:</label>
        <input type="author" class="form-control" id="modalAuthor" placeholder="Author" name="author" required >
        <label for="year" class="form-label">Year:</label>
        <input type="year" class="form-control" id="modalYear" placeholder="Year" name="year" required >
      </div>

      <!-- Modal footer -->
      <div class="modal-footer">
        <button type="button" class="btn btn-success" id="saveAddBook">Save</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancel</button>
      </div>

    </div>
  </div>
</div>

  <!-- The MARK AS READ Modal -->
<div class="modal" id="markAsReadModal">
  <div class="modal-dialog">
    <div class="modal-content">

      <!-- Modal Header -->
      <div class="modal-header">
        <h4 class="modal-title">Mark Book as Read</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        Are you sure you want to mark this book as read?
      </div>

      <!-- Modal footer -->
      <div class="modal-footer">
        <button type="button" class="btn btn-success" id="confirmMarkAsReadBtn">Yes</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">No</button>
      </div>

    </div>
  </div>
</div>


 <!-- The DELETE Modal -->
<div class="modal" id="deleteModal">
  <div class="modal-dialog">
    <div class="modal-content">

      <!-- Modal Header -->
      <div class="modal-header">
        <h4 class="modal-title">Delete Book</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <!-- Modal body -->
      <div class="modal-body">
        Are you sure you want to delete this book?
      </div>

      <!-- Modal footer -->
      <div class="modal-footer">
        <button type="button" class="btn btn-success" id="confirmDeletion">Yes</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal">No</button>
      </div>

    </div>
  </div>
</div>

</body>


<%- include("partials/footer.ejs") %>

<script>
  let selectedBookId = null;
  let deleteBookId = null;

  // Capture book ID when "Mark as Read" button is clicked
  document.querySelectorAll('.set-read-button').forEach(button => {
    button.addEventListener('click', function(){
      selectedBookId = this.getAttribute('data-id');
    });
  });

  // Capture book ID when "Delete" button is clicked
  document.querySelectorAll('.set-delete-button').forEach(button => {
    button.addEventListener('click', function(){
      deleteBookId = this.getAttribute('data-id');
    });
  });

  document.getElementById('confirmMarkAsReadBtn').addEventListener('click', function(){
    if(selectedBookId){
      fetch(`/books/${selectedBookId}/set-read`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          location.reload(); // Reload page to show updated status
        }
      })
      .catch(error => console.error('Error:', error));
      
      // Close modal
      bootstrap.Modal.getInstance(document.getElementById('markAsReadModal')).hide();
    }
  });


   document.getElementById('confirmDeletion').addEventListener('click', function(){
    if(deleteBookId){
      console.log("Deleting book with ID:", deleteBookId);
      fetch(`/delete/${deleteBookId}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          location.reload(); // Reload page to show updated status
        }
      })
      .catch(error => console.error('Error:', error));
      
      // Close modal
      bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
    }
  });


</script>

</html>